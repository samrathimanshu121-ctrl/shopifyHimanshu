<style>


 .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 40px;
    background-color: #111;
    color: #fff;
    font-family: Arial, sans-serif;
  }

  .logo {
    font-size: 24px;
    font-weight: bold;
    color: #ff6f00;
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 25px;
  }

  .nav-links li a {
    text-decoration: none;
    color: #fff;
    font-size: 16px;
    transition: 0.3s;
  }

  .nav-links li a:hover {
    color: #ff6f00;
  }

  .nav-icons a {
    margin-left: 20px;
    font-size: 18px;
    text-decoration: none;
    color: #fff;
    transition: 0.3s;
  }

  .nav-icons a:hover {
    color: #ff6f00;
  }
  .first-class-section {
    padding: 40px;
    background: #f5f5f5;
    text-align: center;
  }
</style>


<nav class="navbar">
  <div class="logo">Sam</div>

  <ul class="nav-links">
    <li><a href="#">Home</a></li>
    <li><a href="#">Shop</a></li>
    <li><a href="#">Categories</a></li>
    <li><a href="#">Offers</a></li>
    <li><a href="#">Contact</a></li>
  </ul>

  <div class="nav-icons">
    <a href="#">🔍</a>
    <a href="#">🛒</a>
    <a href="#">👤</a>
  </div>
</nav>




<div class="first-class-section">
  <h1>{{ section.settings.heading_text }}</h1>
  <h5>  {{  section.settings.paragraph }}</h5>
</div>

{% schema %}
{
  "name": "First Class Section",
  "settings": [
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading Text",
      "default": "This is a first class section"
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": " write paragraph",
      "default":" tell me  about your brand store"

    }
  ],
  "presets": [
    {
      "name": "First Class Section"
    }
  ]
}
{% endschema %}
